<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="envoice_connection" resource="default" engine="innodb" comment="envoice pairing per store URL">
        <column xsi:type="int" name="connection_id" unsigned="true" nullable="false" identity="true"/>
        <column xsi:type="varchar" name="site_url" nullable="false" length="255"/>
        <column xsi:type="text" name="token" nullable="true" comment="Per-store envoice token, encrypted"/>
        <column xsi:type="varchar" name="claim_token" nullable="true" length="64"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="connection_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ENVOICE_CONNECTION_SITE_URL">
            <column name="site_url"/>
        </constraint>
    </table>
    <table name="quote" resource="checkout">
        <column xsi:type="varchar" name="envoice_buyer_reg_no" nullable="true" length="50" comment="Buyer BRN or ID number for the e-invoice"/>
    </table>
    <table name="sales_order" resource="sales">
        <column xsi:type="varchar" name="envoice_buyer_reg_no" nullable="true" length="50" comment="Buyer BRN or ID number for the e-invoice"/>
    </table>
    <table name="envoice_document" resource="sales" engine="innodb" comment="envoice e-invoice state per order">
        <column xsi:type="int" name="order_id" unsigned="true" nullable="false"/>
        <column xsi:type="varchar" name="sale_id" nullable="false" length="64" default=""/>
        <column xsi:type="varchar" name="status" nullable="false" length="32" default=""/>
        <column xsi:type="varchar" name="uuid" nullable="false" length="64" default=""/>
        <column xsi:type="text" name="qr_link" nullable="true"/>
        <column xsi:type="varchar" name="buyer_tin" nullable="false" length="30" default=""/>
        <column xsi:type="varchar" name="buyer_id_type" nullable="false" length="20" default=""/>
        <column xsi:type="varchar" name="buyer_id_value" nullable="false" length="50" default=""/>
        <column xsi:type="varchar" name="buyer_name" nullable="false" length="255" default=""/>
        <column xsi:type="datetime" name="validated_at" nullable="true" comment="LHDN validation time, UTC"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="order_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="ENVOICE_DOCUMENT_ORDER_ID_SALES_ORDER_ENTITY_ID" table="envoice_document" column="order_id" referenceTable="sales_order" referenceColumn="entity_id" onDelete="CASCADE"/>
    </table>
    <table name="envoice_credit_note" resource="sales" engine="innodb" comment="envoice credit note state per credit memo">
        <column xsi:type="int" name="creditmemo_id" unsigned="true" nullable="false"/>
        <column xsi:type="int" name="order_id" unsigned="true" nullable="false"/>
        <column xsi:type="varchar" name="sale_id" nullable="false" length="64" default=""/>
        <column xsi:type="varchar" name="status" nullable="false" length="32" default=""/>
        <column xsi:type="varchar" name="uuid" nullable="false" length="64" default=""/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="creditmemo_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="ENVOICE_CREDIT_NOTE_CREDITMEMO_ID_SALES_CREDITMEMO_ENTITY_ID" table="envoice_credit_note" column="creditmemo_id" referenceTable="sales_creditmemo" referenceColumn="entity_id" onDelete="CASCADE"/>
        <index referenceId="ENVOICE_CREDIT_NOTE_ORDER_ID" indexType="btree">
            <column name="order_id"/>
        </index>
    </table>
    <table name="envoice_queue" resource="sales" engine="innodb" comment="envoice work queue, drained by cron">
        <column xsi:type="int" name="job_id" unsigned="true" nullable="false" identity="true"/>
        <column xsi:type="varchar" name="kind" nullable="false" length="16" comment="submit or creditnote"/>
        <column xsi:type="varchar" name="mode" nullable="false" length="16" default="auto" comment="auto, individual or consolidated"/>
        <column xsi:type="int" name="order_id" unsigned="true" nullable="false"/>
        <column xsi:type="int" name="creditmemo_id" unsigned="true" nullable="false" default="0"/>
        <column xsi:type="varchar" name="status" nullable="false" length="16" default="pending" comment="pending, done or failed"/>
        <column xsi:type="smallint" name="attempts" unsigned="true" nullable="false" default="0"/>
        <column xsi:type="datetime" name="next_run_at" nullable="false"/>
        <column xsi:type="text" name="last_error" nullable="true"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="job_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ENVOICE_QUEUE_KIND_ORDER_ID_CREDITMEMO_ID">
            <column name="kind"/>
            <column name="order_id"/>
            <column name="creditmemo_id"/>
        </constraint>
        <index referenceId="ENVOICE_QUEUE_STATUS_NEXT_RUN_AT" indexType="btree">
            <column name="status"/>
            <column name="next_run_at"/>
        </index>
    </table>
</schema>
